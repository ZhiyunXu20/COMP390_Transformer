# Checkpoints & per-run training outputs
**/*.pt
# Predictions vs checkpoints (runs/):
# - runs/<run>/test_eval/predictions.jsonl is small (~150KB per run) and required for paired bootstrap
#   significance tests (scripts/significance_test.py) on the held-out test set.
# - Training-time runs/<run>/predictions_val_sample.jsonl are excluded by an explicit pattern below
#   (large; training diagnostics only — do not substitute for test_eval preds).
# - Model checkpoints (*.pt, etc.) stay excluded below: large but reproducible by re-running training.
#
# Exclude all predictions.jsonl under runs/ (paths may be large if mis-placed outside test_eval/)
runs/**/predictions.jsonl
# Always track held-out test predictions for every run (evaluate_test.py output).
!runs/**/test_eval/predictions.jsonl
# Training-time val sample decode outputs (large; not for bootstrap / test protocol).
runs/**/predictions_val_sample.jsonl
*.pth
*.ckpt
*.safetensors

# Legacy / duplicate dirs not needed for reproducibility
base_archive/
Base_Improve/
